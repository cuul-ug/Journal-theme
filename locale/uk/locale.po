msgid "plugins.themes.ajlii.seo.ethics"
msgstr "AJLII upholds strict ethics and integrity standards, requiring transparency in funding, AI-assisted tool use, and ethics approval for human or community-based research."

msgid "plugins.themes.ajlii.seo.focus"
msgstr "Open access and scholarly communication in Africa; digital transformation in African universities; consortia collaboration; indigenous knowledge and decolonising libraries; library impact on African higher education; policy and advocacy; Africa-focused library challenges; research data management; innovation in user services and user experience design; preservation and digitisation of African heritage resources; artificial intelligence and automation in libraries; records and archival management."

msgid "plugins.themes.ajlii.seo.mission"
msgstr "To advance Pan-African scholarship by publishing high-quality, practical research on academic libraries, digital inclusion, consortia partnerships, and emerging areas while amplifying underrepresented voices in the global knowledge ecosystem."

msgid "plugins.themes.ajlii.seo.publicationModel"
msgstr "Gold Open Access; Article Processing Charge USD 25; biannual publication in June and December; English language; publisher: Consortium of Uganda University Libraries."

msgid "plugins.themes.ajlii.seo.researcherSupport"
msgstr "AJLII supports early-career scholars through mentorship, pre-submission consultations, writing workshops, and fee waivers for CUUL conference presenters."

msgid "plugins.themes.ajlii.seo.review"
msgstr "AJLII uses double-blind peer review with subject specialists and methodological experts, supported by African scholars and global partners including EIFL and COAR."

msgid "plugins.themes.ajlii.seo.vision"
msgstr "To be the leading platform for transformative library and information science research that drives innovation, collaboration, and equitable knowledge access across Africa."

msgid "plugins.themes.ajlii.aeo.apcAnswer"
msgstr "AJLII is a gold open-access journal with an Article Processing Charge of USD 25. The journal also supports eligible emerging researchers through fee waivers for CUUL conference presenters."

msgid "plugins.themes.ajlii.aeo.apcQuestion"
msgstr "What is the AJLII Article Processing Charge?"

msgid "plugins.themes.ajlii.aeo.focusAnswer"
msgstr "AJLII publishes research, case studies, and reviews on open access, scholarly communication, digital transformation, consortia collaboration, indigenous knowledge, research data management, user services, heritage digitisation, AI in libraries, records, and archives."

msgid "plugins.themes.ajlii.aeo.focusQuestion"
msgstr "What topics does AJLII publish?"

msgid "plugins.themes.ajlii.aeo.frequencyAnswer"
msgstr "AJLII is published biannually in English, with issues released in June and December."

msgid "plugins.themes.ajlii.aeo.frequencyQuestion"
msgstr "How often is AJLII published?"

msgid "plugins.themes.ajlii.aeo.openAccessAnswer"
msgstr "Yes. AJLII follows a gold open-access model and publishes content under the Creative Commons Attribution 4.0 International Licence so readers can access, share, adapt, and reuse articles with attribution."

msgid "plugins.themes.ajlii.aeo.openAccessQuestion"
msgstr "Is AJLII open access?"

msgid "plugins.themes.ajlii.aeo.peerReviewAnswer"
msgstr "AJLII uses double-blind peer review with subject specialists and methodological experts, supported by African scholars and global partners including EIFL and COAR."

msgid "plugins.themes.ajlii.aeo.peerReviewQuestion"
msgstr "What peer review model does AJLII use?"

msgid "plugins.themes.ajlii.aeo.title"
msgstr "AJLII at a glance"

msgid "plugins.themes.ajlii.aeo.updated"
msgstr "Journal profile freshness signal:"

msgid "plugins.themes.ajlii.aeo.whatAnswer"
msgstr "AJLII is a peer-reviewed, gold open-access African library and information science journal published by the Consortium of Uganda University Libraries. It advances practical research on innovation, collaboration, equity, and knowledge access across Africa."

msgid "plugins.themes.ajlii.aeo.whatQuestion"
msgstr "What is AJLII?"

